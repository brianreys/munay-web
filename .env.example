# Copiá este archivo como `.env.local` y completá los valores de tu proyecto Supabase
# (Supabase → Project Settings → Data API / API Keys). La URL va sin "/rest/v1/".
#
# Si estas variables quedan vacías, la web usa los datos de ejemplo de
# `src/datos/catalogo-demo.js` (modo demo).
#
# La clave pública (publishable `sb_publishable_...` o anon `eyJ...`) es pública
# por diseño: la seguridad la dan las políticas RLS de `supabase/esquema.sql`.
# NUNCA pongas acá la clave secreta (`sb_secret_...` o `service_role`).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
